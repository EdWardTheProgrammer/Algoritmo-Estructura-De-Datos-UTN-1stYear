void mostrarMejorYPeorAlumno(TAlumno Alumnos[], int tamanio) {
    int peorNota;
    int mejorNota;
    int posicionMejorAlumno = 0; 
    int posicionPeorAlumno = 0;  
    char eleccion;
    
    cout << "De que materia quiere saber la mejor y peor nota: Matematicas (M) o Lengua (L)?" << endl;
    cin >> eleccion;
    cin.ignore(); // ¡Limpiamos el buffer justo después de usar cin!

    if(toupper(eleccion) == 'M'){
        peorNota = Alumnos[0].notaMatematicas;
        mejorNota = Alumnos[0].notaMatematicas;
        
        // Puedes arrancar el bucle en 1 porque el 0 ya lo asignaste arriba
        for(int i = 1; i < tamanio; i++){
            if(peorNota > Alumnos[i].notaMatematicas){
                peorNota = Alumnos[i].notaMatematicas;
                posicionPeorAlumno = i;
            }
            if(mejorNota < Alumnos[i].notaMatematicas){
                mejorNota = Alumnos[i].notaMatematicas;
                posicionMejorAlumno = i;
            }
        }
        cout << "El mejor alumno en Maths es " << Alumnos[posicionMejorAlumno].nombre << " con: " << mejorNota << endl;
        cout << "El peor alumno en Maths es " << Alumnos[posicionPeorAlumno].nombre << " con: " << peorNota << endl;
    }
    else if (toupper(eleccion) == 'L'){
        peorNota = Alumnos[0].notaLengua;
        mejorNota = Alumnos[0].notaLengua;
        
        for(int i = 1; i < tamanio; i++){
            if(peorNota > Alumnos[i].notaLengua){
                peorNota = Alumnos[i].notaLengua;
                posicionPeorAlumno = i;
            }
            if(mejorNota < Alumnos[i].notaLengua){
                mejorNota = Alumnos[i].notaLengua;
                posicionMejorAlumno = i;
            }
        }
        cout << "El mejor alumno en Lengua es " << Alumnos[posicionMejorAlumno].nombre << " con: " << mejorNota << endl;
        cout << "El peor alumno en Lengua es " << Alumnos[posicionPeorAlumno].nombre << " con: " << peorNota << endl;
    } else {
        cout << "Opcion de materia invalida." << endl;
    }
}
void realizarOrdenamientoPorBurbuja(TAlumno Alumnos[], int tamanio, char indicacion[]) {
    TAlumno aux; 
    
    for(int i = 0; i < tamanio; i++){
        for(int j = 0; j < tamanio - 1 - i; j++){
            bool debeIntercambiar = false;
            
            if(strcmp(indicacion, "Edad") == 0) {
                if (Alumnos[j].edad > Alumnos[j + 1].edad) debeIntercambiar = true;
            }
            else if(strcmp(indicacion, "Division") == 0) {
                if (Alumnos[j].division > Alumnos[j + 1].division) debeIntercambiar = true;
            }
            
            // Si el criterio se cumplió, hacemos un único swap genérico
            if (debeIntercambiar) {
                aux = Alumnos[j];
                Alumnos[j] = Alumnos[j + 1];
                Alumnos[j + 1] = aux;
            }
        }
    }
}

void buscarAlumnoPorEdad(TAlumno Alumnos[], int tamanio) {
    cout << "Ingrese la edad del alumno: ";
    int edad;
    cin >> edad;
    cin.ignore();
    realizarOrdenamientoPorBurbuja(Alumnos, tamanio, "Edad");
    int ubicacionAlumno = realizarBusquedaBinaria(Alumnos, tamanio, edad);
    if(ubicacionAlumno == -1){
    	cout << "No hay ningun alumno con esa edad" << endl;
	}
	else{
		cout << "El alumno con esa edad es: " << Alumnos[ubicacionAlumno].nombre << endl;
	}
}

int realizarBusquedaBinaria(TAlumno Alumnos[], int tamanio, int valorBuscado){
	int inicio = 0;
	int fin = tamanio - 1;
	int medio;
	
	while(inicio <= fin){
		medio = (inicio + fin) / 2;
		
		if(Alumnos[medio].edad == valorBuscado){
			return medio;
		}
		if(valorBuscado > Alumnos[medio].edad){
			inicio = medio + 1;
		}
		else{
			fin = medio - 1;
		}
	}
	return -1;
}

void mostrarPromedioCorteDeControl(TAlumno alumnos[], int tamanio){
	TAlumno alumnosAuxiliar[CAPACIDADMAX];
	for(int i = 0; i < tamanio; i++){
		strcpy(alumnosAuxiliar[i].nombre, alumnos[i].nombre);
		alumnosAuxiliar[i].notaMatematicas = alumnos[i].notaMatematicas;
		alumnosAuxiliar[i].notaLengua = alumnos[i].notaLengua;
		alumnosAuxiliar[i].curso = alumnos[i].curso;
		alumnosAuxiliar[i].edad = alumnos[i].edad;
		alumnosAuxiliar[i].division = alumnos[i].division;
	}
	realizarOrdenamientoPorBurbuja(alumnosAuxiliar, tamanio, "Division");
	int i = 0;
	float notasTotalDivision;
	int cantAlumnosDivision;
	while(i < tamanio){
	int divisionActual = alumnosAuxiliar[i].division;
	notasTotalDivision = 0;
	int cantAlumnosDivision = 0;
	while(i < tamanio && divisionActual == alumnosAuxiliar[i].division){
		notasTotalDivision += alumnosAuxiliar[i].notaMatematicas;
		i++;
		cantAlumnosDivision++;
	}
	cout << "Promedio del curso " << divisionActual << ": " <<notasTotalDivision / cantAlumnosDivision<<endl;
	}
}
	
