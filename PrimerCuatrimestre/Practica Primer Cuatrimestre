void realizarCargaConDesplazamiento (TAlumno alumnos[], int &tamanio, TAlumno alumnoNuevo, int posicion){
	posicion--;
	for(int i = tamanio - 1; i >= posicion; i--){
		alumnos[i+1] = alumnos[i];
	}
	alumnos[posicion] = alumnoNuevo;
	tamanio++;
}

int realizarBusquedaSecuencial(TAlumno alumnos[], int tamanio, char nombreBuscado[50]){
    for(int i = 0; i < tamanio; i++){
        if(_stricmp(alumnos[i].nombre, nombreBuscado) == 0){ //Usa _stricmp porque no distingue mayusculas o minusculas. Permitiendo que, por ejemplo: Eduardo, eduardo y EDUARDO sean lo mismo. Ademas, no se puede usar tolower/toupper en cadenas de caracteres
            return i;
        }
    }
    return -1;
}

